+// extractFieldsFromCAR resolves the field blocks linked by the current composite
+// root. The root alone only exposes link names, which is insufficient for
+// address/topic allowlists; the linked blocks contain the current field values.
+func extractFieldsFromCAR(carData []byte) (map[string]any, error) {
+	reader, err := car.NewBlockReader(bytes.NewReader(carData))
+	if err != nil {
+		return nil, err
+	}
+	if len(reader.Roots) == 0 {
+		return nil, ErrEmptyCARRoots
+	}
+
+	rootCID := reader.Roots[0]
+	blocks := make(map[string]*coreblock.Block)
+	var rootBlock *coreblock.Block
+
+	for {
+		carBlock, nextErr := reader.Next()
+		if errors.Is(nextErr, io.EOF) {
+			break
+		}
+		if nextErr != nil {
+			return nil, nextErr
+		}
+
+		decoded, decodeErr := coreblock.GetFromBytes(carBlock.RawData())
+		if decodeErr != nil {
+			// Signature and encryption blocks are part of the CAR but do not carry
+			// document field values.
+			continue
+		}
+		blocks[carBlock.Cid().String()] = decoded
+		if carBlock.Cid().Equals(rootCID) {
+			rootBlock = decoded
+		}
+	}
+
+	if rootBlock == nil {
+		return nil, ErrCARRootBlockNotFound
+	}
+
+	fields := extractFieldsFromBlock(rootBlock)
+	for _, link := range rootBlock.Links {
+		fieldBlock := blocks[link.Link.Cid.String()]
+		if fieldBlock == nil {
+			continue
+		}
+
+		name := fieldBlock.Delta.GetFieldName()
+		if name == "" {
+			name = link.Name
+		}
+		if name != "" {
+			var value any
+			if data := fieldBlock.Delta.GetData(); data != nil {
+				if err := cbor.Unmarshal(data, &value); err != nil {
+					return nil, err
+				}
+			}
+			fields[name] = value
+		}
+	}
+	return fields, nil
+}
