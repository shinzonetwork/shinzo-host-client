{
  "uid": "shinzo-host-multi",
  "title": "Shinzo Host - multi",
  "description": "Shinzo host fleet: compare 3-6 nodes and spot the bad one.",
  "tags": [
    "shinzo",
    "host",
    "multi"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Shinzo",
      "tags": [
        "shinzo"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "tooltip": "",
      "url": ""
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/grafanacloud-.*-prom/"
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(shinzo_host_views, job)",
          "refId": "job"
        },
        "definition": "label_values(shinzo_host_views, job)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(shinzo_host_views{job=~\"$job\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(shinzo_host_views{job=~\"$job\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "chain",
        "label": "Chain",
        "description": "Chain prefix of the replicated collection names (e.g. Ethereum__Mainnet). Filters the document panels only; other host metrics carry no chain label.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(shinzo_host_documents_total{job=~\"$job\", instance=~\"$instance\"}, collection)",
          "refId": "chain"
        },
        "definition": "label_values(shinzo_host_documents_total{job=~\"$job\", instance=~\"$instance\"}, collection)",
        "regex": "/^(.+)__[^_]+$/",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "table",
      "title": "Fleet",
      "description": "One row per instance, worst first. Issues counts failing checks: no documents received in 10m, 0 peers, lag > 50 blocks, down (seen in the time range but not reporting now). Chains = chains with documents received in the range. Click an instance to open Shinzo Host - single.",
      "targets": [
        {
          "expr": "sum by (instance) (\n  label_replace((sum by (instance) (increase(shinzo_host_documents_total{job=~\"$job\", instance=~\"$instance\"}[10m])) or 0 * max by (instance) (process_uptime_seconds{job=~\"$job\", instance=~\"$instance\"})) == bool 0, \"check\", \"receiving\", \"\", \"\")\n  or label_replace(max by (instance) (shinzo_p2p_peers{job=~\"$job\", instance=~\"$instance\"}) == bool 0, \"check\", \"peers\", \"\", \"\")\n  or label_replace((max by (instance) (shinzo_host_block_received{job=~\"$job\", instance=~\"$instance\"}) - max by (instance) (shinzo_host_block_height{job=~\"$job\", instance=~\"$instance\"})) > bool 50, \"check\", \"lag\", \"\", \"\")\n  or label_replace(max by (instance) (present_over_time(process_uptime_seconds{job=~\"$job\", instance=~\"$instance\"}[$__range])) unless max by (instance) (process_uptime_seconds{job=~\"$job\", instance=~\"$instance\"}), \"check\", \"down\", \"\", \"\")\n)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "max by (instance, service_version) (target_info{job=~\"$job\", instance=~\"$instance\"})",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "count by (instance) (count by (instance, chain) (label_replace(increase(shinzo_host_documents_total{job=~\"$job\", instance=~\"$instance\"}[$__range]) > 0, \"chain\", \"$1\", \"collection\", \"(.+)__[^_]+\")))",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "max by (instance) (shinzo_host_block_height{job=~\"$job\", instance=~\"$instance\"})",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "max by (instance) (shinzo_host_block_received{job=~\"$job\", instance=~\"$instance\"}) - max by (instance) (shinzo_host_block_height{job=~\"$job\", instance=~\"$instance\"})",
          "legendFormat": "",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "max by (instance) (shinzo_p2p_peers{job=~\"$job\", instance=~\"$instance\"})",
          "legendFormat": "",
          "refId": "F",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "max by (instance) (shinzo_host_queue_documents{job=~\"$job\", instance=~\"$instance\"})",
          "legendFormat": "",
          "refId": "G",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum by (instance) (rate(shinzo_host_documents_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])) * 60",
          "legendFormat": "",
          "refId": "H",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "(sum by (instance) (rate(shinzo_host_attestations_total{job=~\"$job\", instance=~\"$instance\", result=\"error\"}[$__rate_interval])) or sum by (instance) (rate(shinzo_host_attestations_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])) * 0) / sum by (instance) (rate(shinzo_host_attestations_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "I",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum by (instance) (rate(shinzo_host_query_duration_seconds_count{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])) * 60",
          "legendFormat": "",
          "refId": "J",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "max by (instance) (shinzo_host_views{job=~\"$job\", instance=~\"$instance\"})",
          "legendFormat": "",
          "refId": "K",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "max by (instance) (process_uptime_seconds{job=~\"$job\", instance=~\"$instance\"})",
          "legendFormat": "",
          "refId": "L",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum by (instance) (resets(process_uptime_seconds{job=~\"$job\", instance=~\"$instance\"}[$__range]))",
          "legendFormat": "",
          "refId": "M",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #B": true
            },
            "indexByName": {
              "instance": 0,
              "Value #A": 1,
              "service_version": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7,
              "Value #H": 8,
              "Value #I": 9,
              "Value #J": 10,
              "Value #K": 11,
              "Value #L": 12,
              "Value #M": 13
            },
            "renameByName": {
              "instance": "Instance",
              "service_version": "Version",
              "Value #A": "Issues",
              "Value #C": "Chains",
              "Value #D": "Height",
              "Value #E": "Lag",
              "Value #F": "Peers",
              "Value #G": "Queue",
              "Value #H": "Docs/min",
              "Value #I": "Attest. err %",
              "Value #J": "Queries/min",
              "Value #K": "Views",
              "Value #L": "Uptime",
              "Value #M": "Restarts"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Issues",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false
          },
          "noValue": "-"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Instance"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open ${__data.fields.instance} in Shinzo Host - single",
                    "url": "/d/shinzo-host-single?var-job=${job}&var-instance=${__data.fields.instance}&${datasource:queryparam}&${__url_time_range}"
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 220
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Issues"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "OK",
                        "index": 0
                      }
                    }
                  }
                ]
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 80
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Lag"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 10
                    },
                    {
                      "color": "red",
                      "value": 50
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Peers"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Queue"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1000
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Attest. err %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.01
                    },
                    {
                      "color": "red",
                      "value": 0.05
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Restarts"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 3
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Docs/min"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Queries/min"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Height"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Views"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Chains"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Issues",
            "desc": true
          }
        ]
      },
      "id": 1,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "row",
      "title": "Fleet totals",
      "collapsed": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 2,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Fleet documents received",
      "description": "Documents received from peers across all selected instances, by collection. Filtered by the Chain variable.",
      "targets": [
        {
          "expr": "sum by (collection) (rate(shinzo_host_documents_total{job=~\"$job\", instance=~\"$instance\", collection=~\"${chain}__.+\"}[$__rate_interval])) * 60",
          "legendFormat": "{{collection}}",
          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: docs/min",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Fleet billed queries",
      "description": "Billing gate decisions across all selected instances.",
      "targets": [
        {
          "expr": "sum(rate(shinzo_host_billing_requests_total{job=~\"$job\", instance=~\"$instance\", result=\"allow\"}[$__rate_interval])) * 60",
          "legendFormat": "allowed",
          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum by (result) (rate(shinzo_host_billing_requests_total{job=~\"$job\", instance=~\"$instance\", result!=\"allow\"}[$__rate_interval])) * 60",
          "legendFormat": "{{result}}",
          "range": true,
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: req/min",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "allowed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "deny"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Fleet errors",
      "description": "Error signals summed across all selected instances.",
      "targets": [
        {
          "expr": "sum(rate(shinzo_host_block_signatures_total{job=~\"$job\", instance=~\"$instance\", result=\"error\"}[$__rate_interval])) * 60",
          "legendFormat": "invalid signatures",
          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
